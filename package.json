{
  "name": "atelier-prototype",
  "version": "0.14.0-alpha.34",
  "description": "Atelier, a durable and policy-aware Agentic Development Environment runtime",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "atlr": "./bin/atlr.mjs"
  },
  "scripts": {
    "atlr": "node ./bin/atlr.mjs",
    "atlr:dev": "node --no-warnings --experimental-strip-types apps/cli/src/main.ts",
    "doctor": "aubr atlr -- doctor",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check:metadata": "node --no-warnings --experimental-strip-types scripts/check-release-metadata.ts",
    "test": "node --no-warnings --experimental-strip-types --import ./tests/test-environment.ts --test --test-concurrency=8 tests/*.test.ts",
    "test:coverage": "node --no-warnings --experimental-strip-types --import ./tests/test-environment.ts --experimental-test-coverage --test --test-concurrency=8 tests/*.test.ts",
    "smoke": "bash ./scripts/smoke.sh",
    "check": "npm run check:metadata && npm run typecheck && npm test && npm run test:path-alias && npm run smoke",
    "prepack": "npm run build",
    "test:codesearch": "aubr test:codesearch:live",
    "test:codesearch:live": "bash ./scripts/probe-codesearch.sh",
    "evaluate:code": "node --no-warnings --experimental-strip-types scripts/evaluate-code.ts",
    "fixtures:codesearch": "node --no-warnings --experimental-strip-types scripts/update-codesearch-fixtures.ts",
    "collect:codesearch": "bash ./scripts/collect-codesearch-knowledge.sh",
    "test:octocode:live": "bash ./scripts/collect-octocode-knowledge.sh",
    "collect:octocode": "bash ./scripts/collect-octocode-knowledge.sh",
    "setup:octocode": "node --no-warnings --experimental-strip-types scripts/setup-octocode-development.ts",
    "evaluate:code:octocode": "node --no-warnings --experimental-strip-types scripts/evaluate-code.ts --providers octocode",
    "evaluate:code:all": "node --no-warnings --experimental-strip-types scripts/evaluate-code.ts --providers codesearch,octocode",
    "launch:dev": "node --no-warnings --experimental-strip-types apps/cli/src/main.ts launch",
    "launch": "node ./bin/atlr.mjs launch",
    "pretest": "npm run build",
    "test:path-alias": "bash ./scripts/test-path-alias.sh"
  },
  "pi": {
    "extensions": [
      "./dist/apps/pi-extension/src/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0",
    "@earendil-works/pi-tui": ">=0.80.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7"
  },
  "dependencies": {},
  "packageManager": "aube@1.29.1",
  "main": "./dist/packages/core/src/index.js",
  "types": "./dist/packages/core/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/packages/core/src/index.d.ts",
      "import": "./dist/packages/core/src/index.js"
    },
    "./pi-extension": {
      "types": "./dist/apps/pi-extension/src/index.d.ts",
      "import": "./dist/apps/pi-extension/src/index.js"
    }
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE",
    "docs/"
  ]
}
